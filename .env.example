# PostgreSQL 14+. Use the provider connection string with certificate verification.
DATABASE_URL=postgresql://elysium:elysium@localhost:5432/elysium
APP_URL=http://localhost:3000
# Generate independently with: openssl rand -hex 32
BOOKING_SECRET=
CRON_SECRET=
# Test mode requires Stripe test keys and never accepts real money.
BOOKING_MODE=test
# Use matching keys from one Stripe account. The publishable key is built into the client bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICING_CONFIRMED=false
# 100 basis points = 1%; tenths are supported. Set only after tax treatment is confirmed.
BOOKING_TAX_BPS=0
# Local email files only work with BOOKING_MODE=test.
EMAIL_MODE=file
EMAIL_FROM=Elysium <bookings@example.com>
STAFF_EMAIL=owner@example.com
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
